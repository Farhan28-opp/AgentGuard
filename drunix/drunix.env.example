# Copy to drunix/drunix.env (git-ignored) or export these variables.
DRUNIX_HOME=/path/to/drunix            # the Drunix repository checkout
DRUNIX_RUNTIME=native                  # native | docker
DRUNIX_INFRA=local                     # native only: local | docker (postgres:16 + redis:7 containers)
# macOS: use DRUNIX_INFRA=docker unless redis-server and a PostgreSQL server are installed locally;
# the ledger's world state lives in whichever state database you start with — keep using the same one.
BRIDGE_LISTEN=127.0.0.1:8090
