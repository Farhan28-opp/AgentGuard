# Copy to .env for LOCAL development only (never commit .env).
# REQUIRED: PostgreSQL connection. The app refuses to start without it.
# postgres:// and postgresql:// URLs (e.g. Railway's) are accepted too.
DATABASE_URL=postgresql+psycopg2://agentguard:CHANGE_ME@127.0.0.1:5432/agentguard

# Test suite only (tests/conftest.py) — a throwaway database, never your dev DB.
TEST_DATABASE_URL=postgresql+psycopg2://agentguard:CHANGE_ME@127.0.0.1:5432/agentguard_test

# Agent private keys. Leave AGENT_KEY_SEED empty locally to use random keys in
# ./dev_keys (git-ignored). On Railway set AGENT_KEY_SEED to a long random
# secret: keys are then derived from it and nothing is written to disk.
AGENT_KEY_SEED=
# DEV_KEYS_DIR=/path/outside/the/repo/agentguard-keys

# Demo / behaviour
DEMO_MODE=true                 # enables /demo/* (scoped reset + Security Lab)
BOOTSTRAP_ON_STARTUP=true      # upsert catalogue + demo user's standing authority
RESERVATION_TTL_SECONDS=90     # authorization window for a held payment
EXPIRY_SWEEP_SECONDS=30        # background release of expired holds (0 = off)
RISK_TIMEZONE=Asia/Kolkata     # "unusual time" feature: local normal hours
RISK_NORMAL_HOURS_START=6
RISK_NORMAL_HOURS_END=23

# Server (python -m app.serve). Railway provides PORT.
# PORT=8000
# WEB_CONCURRENCY=1

# Drunix on-chain enforcement (docs/DRUNIX_INTEGRATION.md)
#   off     -- PostgreSQL only (default; behaves exactly as before)
#   enforce -- delegation, reserve and commit require a VALID Drunix transaction
DRUNIX_MODE=off
# Local Drunix bridge started by drunix/scripts/bridge.sh
DRUNIX_BRIDGE_URL=http://127.0.0.1:8090
# DRUNIX_BRIDGE_TOKEN=            # optional; must match the bridge's BRIDGE_TOKEN
# DRUNIX_TIMEOUT_SECONDS=45
